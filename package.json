{
  "name": "veasel-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/refresh-release-fallback.mjs && astro build && node scripts/check-links.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --test src/scripts/*.test.js",
    "format": "prettier --plugin prettier-plugin-astro --write .",
    "format:check": "prettier --plugin prettier-plugin-astro --check ."
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "asciinema-player": "^3.17.0",
    "astro": "^7.4.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "^6.0.3"
  }
}
