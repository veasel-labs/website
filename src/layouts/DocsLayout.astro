---
import SiteLayout from "./SiteLayout.astro";

interface Props {
  title: string;
  description: string;
  section?: string;
}

const { title, description, section = "Field guide" } = Astro.props;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const currentPath = Astro.url.pathname.replace(basePath, "") || "/";

const navGroups = [
  {
    label: "Start",
    items: [
      { href: "/docs/", label: "Overview" },
      { href: "/docs/install/", label: "Install" },
      { href: "/docs/quickstart/", label: "First session" },
      { href: "/docs/tui/", label: "TUI" },
    ],
  },
  {
    label: "Work",
    items: [
      { href: "/docs/providers/", label: "Providers" },
      { href: "/docs/skills/", label: "Skills & plugins" },
      { href: "/docs/plugins/", label: "Plugins ledger" },
      { href: "/docs/sessions/", label: "Sessions & context" },
      { href: "/docs/api/", label: "API & headless" },
    ],
  },
  {
    label: "Trust",
    items: [
      { href: "/docs/security/", label: "Security" },
      { href: "/docs/architecture/", label: "Architecture" },
      { href: "/docs/troubleshooting/", label: "Troubleshooting" },
      { href: "/docs/faq/", label: "FAQ" },
      { href: "/docs/roadmap/", label: "Roadmap" },
    ],
  },
];

function isActive(href: string) {
  if (href === "/docs/")
    return currentPath === "/docs/" || currentPath === "/docs";
  return currentPath === href || currentPath.startsWith(href);
}
---

<SiteLayout title={title} description={description}>
  <div class="docs-shell wrap">
    <aside class="docs-sidebar" aria-label="Documentation">
      <p class="docs-sidebar-kicker">{section}</p>
      {navGroups.map((group) => (
        <div class="docs-nav-group">
          <p class="docs-nav-label">{group.label}</p>
          <ul>
            {group.items.map((item) => (
              <li>
                <a
                  href={`${basePath}${item.href}`}
                  aria-current={isActive(item.href) ? "page" : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
      <p class="docs-sidebar-foot">
        Deep contracts live in the{" "}
        <a href="https://github.com/veasel-labs/veasel/tree/main/docs">
          runtime docs
        </a>
        .
      </p>
    </aside>
    <div class="docs-main">
      <slot />
    </div>
  </div>
</SiteLayout>
