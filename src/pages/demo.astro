---
import SiteLayout from "../layouts/SiteLayout.astro";
import walkthrough from "../data/demo-walkthrough.json";
import verifiedRelease from "../data/verified-release.json";

const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const steps = walkthrough.steps;
---

<SiteLayout
  title="Product walkthrough"
  description="Interactive guided walkthrough of Veasel Code: install, connect, review edits/shell/MCP, and headless run — labeled as a script, not a live session."
>
  <section class="demo-page wrap">
    <p class="kicker">
      <span class="sparkle" aria-hidden="true">
        ✳
      </span>{" "}
      TRY THE FLOW
    </p>
    <h1>
      A real path.
      <br />
      <em>Not a fake run.</em>
    </h1>
    <p class="lede">
      Step through the product the way it ships: loopback API, approval-gated
      edits and shell, configured MCP, and headless <code>veasel run</code>.
      This page is a guided script of authentic commands — it does not call a
      model or invent benchmark scores.
    </p>

    <aside class="demo-banner" role="note">
      <strong>{walkthrough.label}</strong>
      <p>{walkthrough.disclaimer}</p>
      <p>
        Verified download fallback on this site:{" "}
        <a href={verifiedRelease.release_url}>
          <code>{verifiedRelease.tag}</code>
        </a>
        . Source commit{" "}
        <code>{verifiedRelease.source_commit.slice(0, 12)}</code>.
      </p>
    </aside>

    <div class="demo-shell">
      <nav class="demo-steps" aria-label="Walkthrough steps">
        <p class="demo-steps-label">Steps</p>
        <ol id="demo-step-list">
          {steps.map((step, index) => (
            <li>
              <button
                type="button"
                class="demo-step-button"
                data-demo-step={index}
                aria-current={index === 0 ? "step" : undefined}
              >
                <span class="demo-step-index">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span>
                  <b>{step.title}</b>
                  <small>{step.kicker}</small>
                </span>
              </button>
            </li>
          ))}
        </ol>
      </nav>

      <div class="demo-stage">
        <div class="demo-stage-head">
          <p id="demo-kicker" class="demo-kicker">
            {steps[0].kicker}
          </p>
          <h2 id="demo-title">{steps[0].title}</h2>
          <p id="demo-summary" class="demo-summary">
            {steps[0].summary}
          </p>
        </div>

        <div
          class="demo-terminal"
          aria-live="polite"
          aria-atomic="true"
          aria-label="Walkthrough terminal script"
        >
          <div class="demo-terminal-bar">
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
            <b>veasel · walkthrough</b>
            <i>scripted</i>
          </div>
          <p id="demo-prompt" class="demo-prompt">
            <span>Goal</span>
            {steps[0].prompt}
          </p>
          <pre id="demo-lines" class="demo-lines"><code>
{
              steps[0].lines
                .map((line) => {
                  if (line.kind === "comment") return line.text;
                  if (line.kind === "command") return `$ ${line.text}`;
                  if (line.kind === "user") return `you › ${line.text}`;
                  if (line.kind === "agent") return `veasel › ${line.text}`;
                  if (line.kind === "tool") return `tool · ${line.text}`;
                  return line.text;
                })
                .join("\n")
            }
          </code></pre>
          <p id="demo-note" class="demo-note">
            {steps[0].note}
          </p>
        </div>

        <div class="demo-controls">
          <button type="button" id="demo-prev" class="button button-quiet">
            Previous
          </button>
          <p id="demo-progress" class="demo-progress" aria-live="polite">
            Step 1 of {steps.length}
          </p>
          <button type="button" id="demo-next" class="button button-dark">
            Next step <span aria-hidden="true">→</span>
          </button>
        </div>
        <p class="demo-keys">
          Keyboard: <kbd>←</kbd> <kbd>→</kbd> or <kbd>j</kbd> <kbd>k</kbd> ·
          <kbd>1</kbd>–<kbd>{Math.min(steps.length, 9)}</kbd> jump
        </p>
      </div>
    </div>

    <div class="demo-links">
      <a class="text-link" href={`${basePath}/docs/quickstart/`}>
        Quickstart <span aria-hidden="true">→</span>
      </a>
      <a class="text-link" href={`${basePath}/docs/mcp/`}>
        MCP guide <span aria-hidden="true">→</span>
      </a>
      <a class="text-link" href={`${basePath}/downloads/`}>
        Downloads <span aria-hidden="true">→</span>
      </a>
      <a class="text-link" href={`${basePath}/benchmarks/`}>
        Honest measurements <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</SiteLayout>

<script define:vars={{ steps }}>
  const buttons = Array.from(document.querySelectorAll("[data-demo-step]"));
  const title = document.querySelector("#demo-title");
  const kicker = document.querySelector("#demo-kicker");
  const summary = document.querySelector("#demo-summary");
  const prompt = document.querySelector("#demo-prompt");
  const lines = document.querySelector("#demo-lines code");
  const note = document.querySelector("#demo-note");
  const progress = document.querySelector("#demo-progress");
  const prev = document.querySelector("#demo-prev");
  const next = document.querySelector("#demo-next");
  let index = 0;

  const formatLines = (step) =>
    step.lines
      .map((line) => {
        if (line.kind === "comment") return line.text;
        if (line.kind === "command") return `$ ${line.text}`;
        if (line.kind === "user") return `you › ${line.text}`;
        if (line.kind === "agent") return `veasel › ${line.text}`;
        if (line.kind === "tool") return `tool · ${line.text}`;
        return line.text;
      })
      .join("\n");

  const show = (nextIndex) => {
    index = Math.max(0, Math.min(steps.length - 1, nextIndex));
    const step = steps[index];
    if (title) title.textContent = step.title;
    if (kicker) kicker.textContent = step.kicker;
    if (summary) summary.textContent = step.summary;
    if (prompt) prompt.innerHTML = `<span>Goal</span>${step.prompt}`;
    if (lines) lines.textContent = formatLines(step);
    if (note) note.textContent = step.note;
    if (progress) progress.textContent = `Step ${index + 1} of ${steps.length}`;
    for (const button of buttons) {
      const selected = Number(button.dataset.demoStep) === index;
      if (selected) button.setAttribute("aria-current", "step");
      else button.removeAttribute("aria-current");
    }
    if (prev instanceof HTMLButtonElement) prev.disabled = index === 0;
    if (next instanceof HTMLButtonElement) {
      next.disabled = index === steps.length - 1;
      next.innerHTML =
        index === steps.length - 1
          ? "Done"
          : 'Next step <span aria-hidden="true">→</span>';
    }
  };

  for (const button of buttons) {
    button.addEventListener("click", () => {
      show(Number(button.dataset.demoStep));
    });
  }
  prev?.addEventListener("click", () => show(index - 1));
  next?.addEventListener("click", () => show(index + 1));
  window.addEventListener("keydown", (event) => {
    const target = event.target;
    if (
      target instanceof HTMLElement &&
      (target.tagName === "INPUT" ||
        target.tagName === "TEXTAREA" ||
        target.isContentEditable)
    ) {
      return;
    }
    if (event.key === "ArrowRight" || event.key === "j") {
      event.preventDefault();
      show(index + 1);
    } else if (event.key === "ArrowLeft" || event.key === "k") {
      event.preventDefault();
      show(index - 1);
    } else if (/^[1-9]$/.test(event.key)) {
      const jump = Number(event.key) - 1;
      if (jump < steps.length) {
        event.preventDefault();
        show(jump);
      }
    }
  });
  show(0);
</script>

<style>
  .demo-page {
    padding-top: 72px;
    padding-bottom: 96px;
  }
  .demo-page > h1 em {
    color: var(--green);
  }
  .demo-banner {
    margin: 28px 0 36px;
    padding: 18px 20px;
    border: 1px solid color-mix(in srgb, var(--green) 35%, var(--line));
    border-radius: 16px;
    background: color-mix(in srgb, var(--mint) 55%, var(--surface));
  }
  .demo-banner strong {
    display: block;
    margin-bottom: 8px;
    font: 700 0.95rem var(--display);
  }
  .demo-banner p {
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.55;
  }
  .demo-banner p + p {
    margin-top: 8px;
  }
  .demo-shell {
    display: grid;
    grid-template-columns: minmax(220px, 280px) minmax(0, 1fr);
    gap: 28px;
    align-items: start;
  }
  .demo-steps {
    position: sticky;
    top: 96px;
    padding: 16px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--surface);
  }
  .demo-steps-label {
    margin: 0 0 12px;
    color: var(--green-dark);
    font: 500 0.58rem var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .demo-steps ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .demo-steps li + li {
    margin-top: 6px;
  }
  .demo-step-button {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 10px;
    width: 100%;
    padding: 10px 12px;
    border: 0;
    border-radius: 12px;
    background: transparent;
    color: var(--ink);
    text-align: left;
    cursor: pointer;
  }
  .demo-step-button:hover,
  .demo-step-button[aria-current="step"] {
    background: var(--mint);
  }
  .demo-step-button:focus-visible {
    outline: 2px solid var(--green);
    outline-offset: 2px;
  }
  .demo-step-index {
    color: var(--green-dark);
    font: 600 0.7rem var(--mono);
  }
  .demo-step-button b {
    display: block;
    font: 700 0.86rem var(--display);
  }
  .demo-step-button small {
    display: block;
    margin-top: 2px;
    color: var(--muted);
    font: 500 0.62rem var(--mono);
    letter-spacing: 0.04em;
  }
  .demo-stage-head {
    margin-bottom: 18px;
  }
  .demo-kicker {
    margin: 0 0 8px;
    color: var(--green-dark);
    font: 500 0.62rem var(--mono);
    letter-spacing: 0.08em;
  }
  .demo-stage-head h2 {
    margin: 0 0 8px;
    font: 700 clamp(1.4rem, 2vw, 1.85rem) var(--display);
  }
  .demo-summary {
    margin: 0;
    color: var(--muted);
    line-height: 1.55;
  }
  .demo-terminal {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: #1c1f2e;
    color: #e8e6df;
    box-shadow: 0 18px 40px color-mix(in srgb, var(--ink) 12%, transparent);
  }
  .demo-terminal-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 14px;
    border-bottom: 1px solid color-mix(in srgb, #fff 12%, transparent);
    background: color-mix(in srgb, #000 22%, #1c1f2e);
  }
  .demo-terminal-bar > span {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: #ff6b6b;
  }
  .demo-terminal-bar > span:nth-child(2) {
    background: #ffd166;
  }
  .demo-terminal-bar > span:nth-child(3) {
    background: #7ddea8;
  }
  .demo-terminal-bar b {
    margin-left: 8px;
    font: 600 0.72rem var(--mono);
  }
  .demo-terminal-bar i {
    margin-left: auto;
    color: #7ddea8;
    font: 600 0.62rem var(--mono);
    font-style: normal;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .demo-prompt {
    display: flex;
    gap: 10px;
    margin: 0;
    padding: 14px 16px 0;
    color: #b8c4b0;
    font-size: 0.88rem;
  }
  .demo-prompt span {
    color: #7ddea8;
    font: 600 0.62rem var(--mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .demo-lines {
    margin: 0;
    padding: 14px 16px 8px;
    overflow-x: auto;
    font: 500 0.84rem/1.65 var(--mono);
    white-space: pre-wrap;
  }
  .demo-note {
    margin: 0;
    padding: 12px 16px 16px;
    border-top: 1px solid color-mix(in srgb, #fff 10%, transparent);
    color: #9aa39a;
    font-size: 0.8rem;
    line-height: 1.5;
  }
  .demo-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    justify-content: space-between;
    margin-top: 18px;
  }
  .demo-progress {
    margin: 0;
    color: var(--muted);
    font: 600 0.72rem var(--mono);
  }
  .demo-keys {
    margin: 14px 0 0;
    color: var(--muted);
    font-size: 0.78rem;
  }
  .demo-keys kbd {
    display: inline-block;
    min-width: 1.4em;
    padding: 2px 6px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--surface);
    font: 600 0.72rem var(--mono);
  }
  .demo-links {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    margin-top: 40px;
  }
  @media (max-width: 900px) {
    .demo-shell {
      grid-template-columns: 1fr;
    }
    .demo-steps {
      position: static;
    }
  }
  :root[data-theme="dark"] .demo-banner {
    background: color-mix(in srgb, var(--mint) 18%, var(--surface));
  }
</style>
