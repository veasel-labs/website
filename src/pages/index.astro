---
import SiteLayout from "../layouts/SiteLayout.astro";

const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<SiteLayout
  title="Veasel Code — local agent, visible steps"
  description="Veasel Code is an open-source coding agent built in V. Local-first sessions, multi-provider chat, and approvals before edits, shell, or MCP."
>
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="kicker">
        <span class="sparkle">✳</span> LOCAL · LOOPBACK · APPROVAL-GATED
      </p>
      <h1 id="hero-title">
        Big ideas.
        <br />
        <span>Little steps.</span>
        <br />
        Working code.
      </h1>
      <p class="hero-text">
        Meet <strong>Veasel Code</strong>, a V-native coding agent. Sessions
        live in local SQLite on loopback. Veasel streams replies, inspects your
        workspace, and waits for approval before edits, shell, or MCP. Prompts
        and tool results go to your chosen provider — never an invented agent
        story.
      </p>
      <div class="hero-actions">
        <a class="button button-dark" href={`${basePath}/downloads/`}>
          Download preview <span aria-hidden="true">↓</span>
        </a>
        <a class="button button-quiet" href={`${basePath}/docs/`}>
          Field guide <span aria-hidden="true">→</span>
        </a>
      </div>
      <div class="hero-meta">
        <span class="pulse"></span> Early preview · Open source · Built in V
      </div>
    </div>
    <div
      class="hero-art"
      aria-label="A playful illustrated code workspace with a green V mark"
    >
      <div class="sun"></div>
      <div class="orbit orbit-one"></div>
      <div class="orbit orbit-two"></div>
      <div class="spark spark-a">✦</div>
      <div class="spark spark-b">✳</div>
      <div class="spark spark-c">✧</div>
      <div class="sticker sticker-v">
        <img
          src={`${basePath}/v-logo.png`}
          alt="V programming language logo"
          width="52"
          height="52"
        />
        <small>
          BUILT
          <br />
          IN V
        </small>
      </div>
      <div class="mascot-badge">
        <img
          src={`${basePath}/veasel-pixel.svg`}
          alt="Pixel-art portrait of Veasel, the V language mascot"
          width="76"
          height="52"
        />
      </div>
      <div
        class="tui-preview"
        aria-label="HTML-rendered preview of Veasel Code running in a terminal"
      >
        <div class="tui-titlebar">
          <div class="tui-window-dots" aria-hidden="true">
            <i></i>
            <i></i>
            <i></i>
          </div>
          <span class="tui-window-title">
            VEASEL <b>/</b> CODE
          </span>
          <span class="tui-window-host">~/your-project</span>
          <span class="tui-live">
            <i></i> LOCAL
          </span>
        </div>
        <div class="tui-screen">
          <aside class="tui-sessions" aria-label="Session list">
            <span class="tui-eyebrow">
              SESSIONS <b>02</b>
            </span>
            <div class="tui-session tui-session-active">
              <i></i>
              <span>
                <b>Polish the landing page</b>
                <small>~/veasel.dev</small>
              </span>
            </div>
            <div class="tui-session">
              <i></i>
              <span>
                <b>Explore the V parser</b>
                <small>~/vlang</small>
              </span>
            </div>
            <div class="tui-add-session">
              ＋ <span>new workspace</span>
            </div>
            <div class="tui-session-foot">
              <span class="tui-avatar">V</span>
              <span>
                <b>VEASEL CODE</b>
                <small>your local workspace</small>
              </span>
            </div>
          </aside>
          <div class="tui-conversation">
            <div class="tui-conversation-head">
              <span>
                <i></i> Polish the landing page
              </span>
              <kbd>Esc</kbd>
            </div>
            <div class="tui-message tui-user">
              <span class="tui-message-label">YOU</span>
              <p>Can you make this hero feel more alive on small screens?</p>
            </div>
            <div class="tui-message tui-agent">
              <span class="tui-message-label">
                <img
                  src={`${basePath}/veasel-pixel.svg`}
                  alt=""
                  width="19"
                  height="14"
                />{" "}
                VEASEL <b>· THINKING THROUGH THE LAYOUT</b>
              </span>
              <p>
                I’ll trace the responsive styles first, then propose a focused
                change you can review.
              </p>
            </div>
            <div class="tui-tool">
              <span>⌕</span>
              <code>read src/styles/hero.css</code>
              <b>done</b>
            </div>
            <div class="tui-proposal">
              <div>
                <span>✳</span>
                <b>Change ready to review</b>
                <small>src/styles/hero.css · +8 −3</small>
              </div>
              <span class="tui-review">
                Review diff <b>↗</b>
              </span>
            </div>
            <div class="tui-composer">
              <span>›</span>
              <span>Ask Veasel to explain or propose a workspace change…</span>
              <i></i>
            </div>
            <div class="tui-status">
              <span>
                <i></i> connected
              </span>
              <span>s models&nbsp; · &nbsp;/theme · /usage</span>
              <span>↑ ↓ navigate</span>
            </div>
          </div>
        </div>
        <div class="tui-caption">
          <span>THE INTERFACE, BUILT IN CODE</span>
          <span>Not a screenshot — every panel is live HTML.</span>
        </div>
      </div>
      <div class="float-note note-top">
        <span>⌁</span> ideas welcome
      </div>
      <div class="float-note note-bottom">
        <span>↗</span> your repo, your rules
      </div>
    </div>
    <div class="hero-ribbon" aria-hidden="true">
      A SMALLER STEP TO YOUR NEXT BIG THING <span>✳</span> A SMALLER STEP TO
      YOUR NEXT BIG THING <span>✳</span>
    </div>
  </section>

  <section class="welcome wrap section-pad" aria-labelledby="welcome-title">
    <div class="section-intro">
      <p class="kicker">VISIBLE STEPS</p>
      <h2 id="welcome-title">
        You steer.
        <br />
        <span>Veasel waits.</span>
      </h2>
    </div>
    <p class="section-lede">
      Coding with an agent should feel like a careful pair, not a handoff.
      Veasel Code keeps every step inspectable, every session resumable, and
      every risky action behind your approval.
    </p>
    <div class="value-grid">
      <article class="value-card card-mint">
        <span class="doodle">⌂</span>
        <p class="card-label">LOCAL FIRST</p>
        <h3>
          Workspace stays
          <br />
          on your machine.
        </h3>
        <p>
          The V backend stores sessions in SQLite and listens on loopback by
          default.
        </p>
      </article>
      <article class="value-card card-yellow">
        <span class="doodle">⏸</span>
        <p class="card-label">APPROVAL GATED</p>
        <h3>
          Edits, shell, and
          <br />
          MCP pause for you.
        </h3>
        <p>
          Review the exact diff, command, or MCP arguments before anything runs.
        </p>
      </article>
      <article class="value-card card-lilac">
        <span class="doodle">⌘</span>
        <p class="card-label">YOUR PROVIDER</p>
        <h3>
          Bring the models
          <br />
          you already use.
        </h3>
        <p>
          OpenAI-compatible, Anthropic, Gemini, and Meta Model API adapters
          share one session workflow.
        </p>
      </article>
    </div>
  </section>

  <section class="provider-band" aria-labelledby="provider-title">
    <div class="wrap provider-inner">
      <div>
        <p class="kicker">MODEL ROUTING</p>
        <h2 id="provider-title">
          One agent core.
          <br />
          <span>Several ways in.</span>
        </h2>
        <p>
          Switch providers in settings while the same local session store and
          review flow stay in place.
        </p>
      </div>
      <div
        class="provider-orbit"
        aria-label="Available AI provider integrations"
      >
        <span class="provider-chip chip-openai">
          <i>◌</i> OpenAI-compatible
        </span>
        <span class="provider-chip chip-claude">
          <i>✳</i> Anthropic
        </span>
        <span class="provider-chip chip-gemini">
          <i>✦</i> Gemini
        </span>
        <span class="provider-chip chip-meta">
          <i>◆</i> Meta Model API
        </span>
        <div class="provider-core">
          <b>one</b>
          <small>
            agent
            <br />
            core
          </small>
        </div>
        <span class="orbit-caption">AVAILABLE IN SOURCE</span>
      </div>
    </div>
  </section>

  <section class="how wrap section-pad" aria-labelledby="how-title">
    <div class="how-heading">
      <p class="kicker">A CLEAR PATH</p>
      <h2 id="how-title">
        Open a project.
        <br />
        <span>Keep the thread.</span>
      </h2>
      <p>
        Small pieces that keep the conversation and the workspace connected.
      </p>
    </div>
    <div class="flow-list">
      <article>
        <span class="flow-icon icon-lime">⌘</span>
        <div>
          <small>01 · YOU</small>
          <h3>Start in a repository</h3>
          <p>Run Veasel from the project you want to work on.</p>
        </div>
        <span class="flow-arrow">↓</span>
      </article>
      <article>
        <span class="flow-icon icon-lavender">☷</span>
        <div>
          <small>02 · VEASEL</small>
          <h3>Keep a lasting session</h3>
          <p>
            Local SQLite storage and a replayable event stream hold the thread.
          </p>
        </div>
        <span class="flow-arrow">↓</span>
      </article>
      <article>
        <span class="flow-icon icon-peach">✳</span>
        <div>
          <small>03 · TOGETHER</small>
          <h3>Review before write</h3>
          <p>
            Veasel streams replies, inspects files, and proposes single-file
            edits. Shell and MCP calls need exact approval first.
          </p>
        </div>
        <span class="flow-arrow">✦</span>
      </article>
    </div>
  </section>

  <section class="reality-band">
    <div class="wrap reality-inner">
      <div>
        <p class="kicker">HONEST STATUS</p>
        <h2>
          What works
          <br />
          <span>today.</span>
        </h2>
        <p>
          Veasel Code is early. We show the foundation as it ships — not a
          promise dressed as a feature.
        </p>
      </div>
      <div class="status-board">
        <div class="status-head">
          <b>BUILD BOARD</b>
          <span>TRACKED WITH THE REPO</span>
        </div>
        <div class="status-row">
          <span class="status-symbol done">✓</span>
          <b>V backend on loopback</b>
          <small>READY</small>
        </div>
        <div class="status-row">
          <span class="status-symbol done">✓</span>
          <b>SQLite sessions + event history</b>
          <small>READY</small>
        </div>
        <div class="status-row">
          <span class="status-symbol done">✓</span>
          <b>OpenTUI session client</b>
          <small>EARLY</small>
        </div>
        <div class="status-row">
          <span class="status-symbol done">✓</span>
          <b>Multi-provider session chat</b>
          <small>READY</small>
        </div>
        <div class="status-row">
          <span class="status-symbol done">✓</span>
          <b>Bounded workspace inspection</b>
          <small>READY</small>
        </div>
        <div class="status-row">
          <span class="status-symbol done">✓</span>
          <b>Review-gated file edits</b>
          <small>READY</small>
        </div>
        <div class="status-row">
          <span class="status-symbol done">✓</span>
          <b>Reviewed shell + MCP calls</b>
          <small>PREVIEW</small>
        </div>
        <div class="status-row">
          <span class="status-symbol done">✓</span>
          <b>Experimental Agent Plugins</b>
          <small>PARTIAL</small>
        </div>
        <a href="https://github.com/veasel-labs/veasel/blob/main/docs/IMPLEMENTATION_PLAN.md">
          See the honest roadmap <span>↗</span>
        </a>
      </div>
    </div>
  </section>

  <section class="start wrap section-pad" id="get-started">
    <div class="start-copy">
      <p class="kicker">GET STARTED</p>
      <h2>
        Install the preview.
        <br />
        <span>Configure a model.</span>
      </h2>
      <p>
        Download Veasel Code, pick a provider in settings, and start working in
        your repository.
      </p>
      <a class="button button-dark" href={`${basePath}/downloads/`}>
        Download Veasel Code <span>→</span>
      </a>
      <a class="text-link" href={`${basePath}/docs/quickstart/`}>
        Read the quickstart <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="install-card">
      <div class="install-top">
        <span class="live-dot"></span> CURRENT PREVIEW
      </div>
      <div class="install-code">
        <small>01&nbsp; DOWNLOAD FOR YOUR PLATFORM</small>
        <code>veasel</code>
        <small>02&nbsp; CONFIGURE YOUR MODEL IN SETTINGS</small>
        <code>Press s · choose provider and model</code>
      </div>
      <div class="install-foot">
        V runtime · OpenTUI client · local SQLite <span>♥</span>
      </div>
    </div>
  </section>

  <section class="finale">
    <div class="wrap finale-inner">
      <div class="finale-star" aria-hidden="true">
        ✳
      </div>
      <p class="kicker">OPEN SOURCE</p>
      <h2>
        Follow the build.
        <br />
        <span>Shape what ships next.</span>
      </h2>
      <a
        href="https://github.com/veasel-labs/veasel"
        class="button button-light"
      >
        Meet us on GitHub <span>↗</span>
      </a>
      <p class="finale-note">
        Prereleases only — verify checksums before you run them.
      </p>
    </div>
  </section>
</SiteLayout>
