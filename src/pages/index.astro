---
import SiteLayout from "../layouts/SiteLayout.astro";

const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<SiteLayout
  title="Veasel Code — your ideas, in motion"
  description="Meet Veasel Code: an open-source coding agent taking shape in V, with local-first sessions and a growing multi-provider runtime."
>
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="kicker">
        <span class="sparkle">✳</span> THE V-NATIVE CODING COMPANION
      </p>
      <h1 id="hero-title">
        Big ideas.
        <br />
        <span>Little steps.</span>
        <br />
        Working code.
      </h1>
      <p class="hero-text">
        Meet <strong>Veasel Code</strong>, a coding agent built in V for people
        who like to stay close to the work. Bring your ideas, pick a supported
        model provider, and keep session history in a local SQLite database.
        Prompts go to the provider you configure.
      </p>
      <div class="hero-actions">
        <a
          class="button button-dark"
          href="https://github.com/veasel-labs/veasel"
        >
          Follow the build <span aria-hidden="true">↗</span>
        </a>
        <a class="button button-quiet" href={`${basePath}/docs/`}>
          Take a look around <span aria-hidden="true">↓</span>
        </a>
      </div>
      <div class="hero-meta">
        <span class="pulse"></span> Early build · Open source · Made with V
      </div>
    </div>
    <div
      class="hero-art"
      aria-label="A playful illustrated code workspace with a green V mark"
    >
      <div class="sun"></div>
      <div class="orbit orbit-one"></div>
      <div class="orbit orbit-two"></div>
      <div class="spark spark-a">✦</div>
      <div class="spark spark-b">✳</div>
      <div class="spark spark-c">✧</div>
      <div class="sticker sticker-v">
        <img
          src={`${basePath}/v-logo.png`}
          alt="V programming language logo"
          width="52"
          height="52"
        />
        <small>
          BUILT
          <br />
          IN V
        </small>
      </div>
      <div class="mascot-badge">
        <img
          src={`${basePath}/veasel-pixel.svg`}
          alt="Pixel-art portrait of Veasel, the V language mascot"
          width="76"
          height="52"
        />
      </div>
      <div class="terminal-card">
        <div class="terminal-bar">
          <span></span>
          <span></span>
          <span></span>
          <b>veasel / your-project</b>
          <i>⌘ K</i>
        </div>
        <div class="terminal-content">
          <p class="terminal-comment">// your next idea starts here</p>
          <p>
            <span class="code-purple">fn</span>{" "}
            <span class="code-green">make_it_real</span>() &#123;
          </p>
          <p class="indent">
            <span class="code-orange">veasel</span>.work(with:{" "}
            <span class="code-yellow">you</span>)
          </p>
          <p>&#125;</p>
          <div class="terminal-result">
            <span class="result-icon">✓</span>
            <span>
              <b>Session saved</b>
              <small>right here, on your machine</small>
            </span>
            <span class="dots">•••</span>
          </div>
        </div>
      </div>
      <div class="float-note note-top">
        <span>⌁</span> ideas welcome
      </div>
      <div class="float-note note-bottom">
        <span>↗</span> your repo, your rules
      </div>
    </div>
    <div class="hero-ribbon" aria-hidden="true">
      A SMALLER STEP TO YOUR NEXT BIG THING <span>✳</span> A SMALLER STEP TO
      YOUR NEXT BIG THING <span>✳</span>
    </div>
  </section>

  <section class="welcome wrap section-pad" aria-labelledby="welcome-title">
    <div class="section-intro">
      <p class="kicker">A GOOD AGENT FEELS LIKE A GOOD PAIR</p>
      <h2 id="welcome-title">
        You steer.
        <br />
        <span>Veasel helps.</span>
      </h2>
    </div>
    <p class="section-lede">
      Coding with AI should feel less like handing over the keys and more like
      having a thoughtful teammate at your side. Veasel Code is being built to
      make every step visible, every session resumable, and your tools yours to
      choose.
    </p>
    <div class="value-grid">
      <article class="value-card card-mint">
        <span class="doodle">⌂</span>
        <p class="card-label">CLOSE TO HOME</p>
        <h3>
          Your workspace
          <br />
          stays yours.
        </h3>
        <p>
          The local V backend keeps session data on your machine and listens on
          loopback.
        </p>
      </article>
      <article class="value-card card-yellow">
        <span class="doodle">↻</span>
        <p class="card-label">PICK UP ANYTIME</p>
        <h3>
          Good ideas
          <br />
          don't disappear.
        </h3>
        <p>
          Sessions and their event history are stored together in SQLite, ready
          to reconnect.
        </p>
      </article>
      <article class="value-card card-lilac">
        <span class="doodle">⌘</span>
        <p class="card-label">BUILT TO BE OPEN</p>
        <h3>
          Choose your
          <br />
          AI sidekick.
        </h3>
        <p>
          Choose OpenAI-compatible, Anthropic, or Gemini through one small
          provider interface.
        </p>
      </article>
    </div>
  </section>

  <section class="provider-band" aria-labelledby="provider-title">
    <div class="wrap provider-inner">
      <div>
        <p class="kicker">YOUR MODEL, YOUR CALL</p>
        <h2 id="provider-title">
          Room for more
          <br />
          than one kind of mind.
        </h2>
        <p>
          Three provider adapters are ready in the current source build. Switch
          the backend configuration while keeping the same session workflow.
        </p>
      </div>
      <div
        class="provider-orbit"
        aria-label="Available AI provider integrations"
      >
        <span class="provider-chip chip-openai">
          <i>◌</i> OpenAI-compatible
        </span>
        <span class="provider-chip chip-claude">
          <i>✳</i> Anthropic
        </span>
        <span class="provider-chip chip-gemini">
          <i>✦</i> Gemini
        </span>
        <div class="provider-core">
          <b>one</b>
          <small>
            agent
            <br />
            core
          </small>
        </div>
        <span class="orbit-caption">AVAILABLE IN SOURCE</span>
      </div>
    </div>
  </section>

  <section class="how wrap section-pad" aria-labelledby="how-title">
    <div class="how-heading">
      <p class="kicker">A SIMPLE SHAPE, WITH ROOM TO GROW</p>
      <h2 id="how-title">
        A clear path
        <br />
        <span>through the work.</span>
      </h2>
      <p>
        Small, sturdy pieces that keep the conversation and the code connected.
      </p>
    </div>
    <div class="flow-list">
      <article>
        <span class="flow-icon icon-lime">⌘</span>
        <div>
          <small>01 · YOU</small>
          <h3>Open a project</h3>
          <p>Start in the repository you want to work on.</p>
        </div>
        <span class="flow-arrow">↓</span>
      </article>
      <article>
        <span class="flow-icon icon-lavender">☷</span>
        <div>
          <small>02 · VEASEL</small>
          <h3>Keep a lasting session</h3>
          <p>Local storage and a replayable event stream hold the thread.</p>
        </div>
        <span class="flow-arrow">↓</span>
      </article>
      <article>
        <span class="flow-icon icon-peach">✳</span>
        <div>
          <small>03 · TOGETHER</small>
          <h3>Choose how to build</h3>
          <p>
            Provider support and careful tool permissions are part of the build
            plan.
          </p>
        </div>
        <span class="flow-arrow">✦</span>
      </article>
    </div>
  </section>

  <section class="reality-band">
    <div class="wrap reality-inner">
      <div>
        <p class="kicker">A REAL FOUNDATION, TAKING SHAPE</p>
        <h2>
          Here’s what works
          <br />
          <span>today.</span>
        </h2>
        <p>
          Veasel Code is early. We’d rather show you exactly where it stands
          than dress a promise up as a feature.
        </p>
      </div>
      <div class="status-board">
        <div class="status-head">
          <b>BUILD BOARD</b>
          <span>UPDATED WITH THE REPO</span>
        </div>
        <div class="status-row">
          <span class="status-symbol done">✓</span>
          <b>V backend on loopback</b>
          <small>READY</small>
        </div>
        <div class="status-row">
          <span class="status-symbol done">✓</span>
          <b>SQLite sessions + event history</b>
          <small>READY</small>
        </div>
        <div class="status-row">
          <span class="status-symbol done">✓</span>
          <b>Terminal session browser</b>
          <small>EARLY</small>
        </div>
        <div class="status-row">
          <span class="status-symbol next">◌</span>
          <b>Multi-provider session chat</b>
          <small>READY</small>
        </div>
        <div class="status-row">
          <span class="status-symbol later">·</span>
          <b>Repository tools + approvals</b>
          <small>PLANNED</small>
        </div>
        <a href="https://github.com/veasel-labs/veasel/blob/main/docs/IMPLEMENTATION_PLAN.md">
          See the honest roadmap <span>↗</span>
        </a>
      </div>
    </div>
  </section>

  <section class="start wrap section-pad" id="get-started">
    <div class="start-copy">
      <p class="kicker">COME BUILD WITH US</p>
      <h2>
        Curious minds
        <br />
        <span>fit right in.</span>
      </h2>
      <p>
        Run the current foundation locally, peek at how it’s put together, or
        follow the next milestones on GitHub.
      </p>
      <a class="button button-dark" href={`${basePath}/docs/`}>
        Read the getting-started guide <span>→</span>
      </a>
    </div>
    <div class="install-card">
      <div class="install-top">
        <span class="live-dot"></span> THE CURRENT BUILD
      </div>
      <div class="install-code">
        <small>01&nbsp; CLONE THE REPO</small>
        <code>git clone https://github.com/veasel-labs/veasel</code>
        <small>02&nbsp; START THE LOCAL SERVER</small>
        <code>v run . serve</code>
        <small>03&nbsp; OPEN THE TERMINAL CLIENT</small>
        <code>v run . tui</code>
      </div>
      <div class="install-foot">
        V + SQLite · Bun for the terminal client <span>♥</span>
      </div>
    </div>
  </section>

  <section class="finale">
    <div class="wrap finale-inner">
      <div class="finale-star" aria-hidden="true">
        ✳
      </div>
      <p class="kicker">THE NEXT LINE IS YOURS</p>
      <h2>
        Let’s make something
        <br />
        <span>worth opening.</span>
      </h2>
      <a
        href="https://github.com/veasel-labs/veasel"
        class="button button-light"
      >
        Meet us on GitHub <span>↗</span>
      </a>
      <p class="finale-note">
        Veasel is the V language mascot. Veasel Code is the coding agent.
      </p>
    </div>
  </section>
</SiteLayout>
