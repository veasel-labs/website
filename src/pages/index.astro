---
import SiteLayout from "../layouts/SiteLayout.astro";
import verifiedRelease from "../data/verified-release.json";

const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const release = verifiedRelease.tag;
---

<SiteLayout
  title="Veasel Code — the local coding agent standard"
  description="Veasel Code is the V-native coding agent: universal skills, graduated sandboxes, MCP with OAuth, a keyboard-first TUI, and honest usage — on your machine, under your approval."
>
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="kicker">
        <span class="sparkle">✳</span> LOCAL · APPROVAL-GATED · V-NATIVE
      </p>
      <h1 id="hero-title">
        The new standard
        <br />
        <span>coding agent.</span>
      </h1>
      <p class="hero-text">
        <strong>Veasel Code</strong> is built in V for the people who refuse
        black-box agents. Sessions stay on loopback SQLite. Skills, sandboxes,
        MCP, compaction, and a SolidJS + OpenTUI terminal client ship today —
        mint chrome, pixel splash, Ctrl+P command palette, reviews, and{" "}
        <code>/</code> <code>@</code> <code>$</code> autocomplete — with
        approvals before edits, shell, or tool calls. No invented Harbor Index
        scores. No fake latency charts. Just the product, as it runs.
      </p>
      <div class="hero-actions">
        <a class="button button-dark" href={`${basePath}/downloads/`}>
          Download {release} <span aria-hidden="true">↓</span>
        </a>
        <a class="button button-quiet" href={`${basePath}/docs/`}>
          Read the field guide <span aria-hidden="true">→</span>
        </a>
      </div>
      <div class="hero-meta">
        <span class="pulse"></span> Verified prerelease · Open source · Built in
        V
      </div>
    </div>
    <div
      class="hero-art"
      aria-label="A playful illustrated code workspace with a green V mark"
    >
      <div class="sun"></div>
      <div class="orbit orbit-one"></div>
      <div class="orbit orbit-two"></div>
      <div class="spark spark-a">✦</div>
      <div class="spark spark-b">✳</div>
      <div class="spark spark-c">✧</div>
      <div class="sticker sticker-v">
        <img
          src={`${basePath}/v-logo.png`}
          alt="V programming language logo"
          width="52"
          height="52"
        />
        <small>
          BUILT
          <br />
          IN V
        </small>
      </div>
      <div class="companion-badge">
        <img
          src={`${basePath}/veasel-companion.png`}
          alt="Blue-gray otter mascot with teal eyes and a mint collar"
          width="76"
          height="53"
        />
      </div>
      <div
        class="tui-preview"
        aria-label="HTML-rendered preview of the SolidJS + OpenTUI Veasel terminal client"
      >
        <div class="tui-titlebar">
          <div class="tui-window-dots" aria-hidden="true">
            <i></i>
            <i></i>
            <i></i>
          </div>
          <span class="tui-window-title">
            VEASEL <b>code</b>
          </span>
          <span class="tui-window-host">~/your-project</span>
          <span class="tui-live">
            <i></i> LOCAL · mint
          </span>
        </div>
        <div class="tui-screen tui-screen-solid">
          <div class="tui-session-bar" aria-label="Session chrome">
            <span>
              SESSION <b>Ship the standard agent</b>
            </span>
            <span class="tui-session-hotkeys">
              <kbd>Ctrl+P</kbd> commands · <kbd>Ctrl+G</kbd> activity ·{" "}
              <kbd>Ctrl+R</kbd> reviews
            </span>
          </div>
          <div class="tui-conversation">
            <div class="tui-splash" aria-hidden="true">
              <img
                src={`${basePath}/veasel-companion.png`}
                alt=""
                width="42"
                height="30"
              />
              <span>pixel companion · mint splash</span>
            </div>
            <div class="tui-message tui-user">
              <span class="tui-message-label">YOU</span>
              <p>Trace the sandbox policy, then propose a focused patch.</p>
            </div>
            <div class="tui-message tui-agent">
              <span class="tui-message-label">
                <img
                  src={`${basePath}/veasel-companion.png`}
                  alt=""
                  width="19"
                  height="13"
                />{" "}
                VEASEL <b>· READING · MAPPING · WAITING</b>
              </span>
              <p>
                Parallel reads + repo map first. Patch, shell, and MCP stay
                queued — nothing takes effect until you approve. Press{" "}
                <kbd>Ctrl+P</kbd> for the command palette.
              </p>
            </div>
            <div class="tui-tool">
              <span>⌕</span>
              <code>read · search · /map</code>
              <b>done</b>
            </div>
            <div class="tui-proposal">
              <div>
                <span>✳</span>
                <b>Change ready to review</b>
                <small>Ctrl+R · Space · a/x · v DiffRenderable</small>
              </div>
              <span class="tui-review">
                Review diff <b>↗</b>
              </span>
            </div>
            <div class="tui-composer tui-compose-panel">
              <span class="tui-compose-title">Compose</span>
              <div class="tui-compose-row">
                <span>›</span>
                <span>
                  Message Veasel… <code>/</code> <code>@</code> <code>$</code> ·
                  Shift+Enter…
                </span>
                <i></i>
              </div>
            </div>
            <div class="tui-status">
              <span>
                <i></i> local · reviewed
              </span>
              <span>Solid · OpenTUI · mint</span>
              <span>↑ ↓ navigate</span>
            </div>
          </div>
        </div>
        <div class="tui-caption">
          <span>SOLID · OPENTUI · MINT</span>
          <span>
            HTML preview of the Veasel terminal client — walk the real CLI/TUI
            on <a href={`${basePath}/demo/`}>Demo</a>.
          </span>
        </div>
      </div>
      <div class="float-note note-top">
        <span>⌁</span> your repo, your rules
      </div>
      <div class="float-note note-bottom">
        <span>↗</span> approve before effect
      </div>
    </div>
    <div class="hero-ribbon" aria-hidden="true">
      THE STANDARD IS LOCAL AND VISIBLE <span>✳</span> THE STANDARD IS LOCAL AND
      VISIBLE <span>✳</span>
    </div>
  </section>

  <section class="welcome wrap section-pad" aria-labelledby="welcome-title">
    <div class="section-intro">
      <p class="kicker">WHAT SHIPS</p>
      <h2 id="welcome-title">
        Declarative claims.
        <br />
        <span>Real capabilities.</span>
      </h2>
    </div>
    <p class="section-lede">
      Every headline below maps to code on the <code>{release}</code> verified
      channel. Footnotes stay honest where platforms differ or conformance is
      still partial.
    </p>
    <div class="value-grid">
      <article class="value-card card-mint">
        <span class="doodle">✳</span>
        <p class="card-label">SKILLS · CATALOG · TRUST</p>
        <h3>
          Universal skills.
          <br />
          One-shot invoke.
        </h3>
        <p>
          Discover <code>SKILL.md</code> roots from Claude, Codex, Cursor,
          OpenCode, Gemini, and more. Model catalog + <code>/connect</code>.
          Session trust, then <code>POST …/skills/invoke</code> for a single
          turn — scripts never auto-run.
        </p>
      </article>
      <article class="value-card card-yellow">
        <span class="doodle">⌂</span>
        <p class="card-label">SANDBOX · MCP · POLICY</p>
        <h3>
          Graduated policy.
          <br />
          Three-OS containment.
        </h3>
        <p>
          <code>ask</code> → <code>auto-edit</code> → <code>sandbox-auto</code>.
          Shell sandboxes on Linux/macOS/Windows. MCP stdio sandbox is opt-in
          via <code>VEASEL_MCP_STDIO_SANDBOX</code> on all three OSes.
        </p>
      </article>
      <article class="value-card card-lilac">
        <span class="doodle">☷</span>
        <p class="card-label">CONTEXT · JOBS · COST</p>
        <h3>
          Compaction. Repo map.
          <br />
          Honest dollars.
        </h3>
        <p>
          Adaptive compaction, extractive repository map, prompt-cache
          accounting, parallel read-only tools, durable async jobs. USD cost
          only from the pinned schedule — never invented savings.
        </p>
      </article>
    </div>
  </section>

  <section class="provider-band" aria-labelledby="standard-title">
    <div class="wrap provider-inner">
      <div>
        <p class="kicker">THE STACK</p>
        <h2 id="standard-title">
          One local core.
          <br />
          <span>Every surface sharp.</span>
        </h2>
        <p>
          Plugins, OAuth refresh, and the SolidJS + OpenTUI terminal client sit
          on the same loopback API — so headless <code>veasel run</code> and the
          TUI never drift apart.
        </p>
      </div>
      <div class="provider-orbit" aria-label="Product surfaces that ship today">
        <span class="provider-chip chip-openai">
          <i>◌</i> Model catalog
        </span>
        <span class="provider-chip chip-claude">
          <i>✳</i> MCP + OAuth
        </span>
        <span class="provider-chip chip-gemini">
          <i>✦</i> DiffRenderable
        </span>
        <span class="provider-chip chip-meta">
          <i>◆</i> V · json2 · SSE
        </span>
        <div class="provider-core">
          <b>one</b>
          <small>
            agent
            <br />
            core
          </small>
        </div>
        <span class="orbit-caption">SHIPPED ON {release}</span>
      </div>
    </div>
  </section>

  <section class="how wrap section-pad" aria-labelledby="claims-title">
    <div class="how-heading">
      <p class="kicker">SCAN THE STANDARD</p>
      <h2 id="claims-title">
        Feature claims
        <br />
        <span>you can verify.</span>
      </h2>
      <p>Product language first. Technical footnotes where honesty matters.</p>
    </div>
    <div class="flow-list">
      <article>
        <span class="flow-icon icon-lime">01</span>
        <div>
          <small>SKILLS &amp; MODELS</small>
          <h3>Universal discovery · catalog · trust · one-shot invoke</h3>
          <p>
            Standalone skills from the roots you already keep;{" "}
            <code>/skills</code> / <code>veasel skills list</code>; session
            enable or one-shot <code>…/skills/invoke</code>. Two-hundred-plus
            endpoint presets across four protocols — presets are not
            vendor-native SDKs.
          </p>
        </div>
        <span class="flow-arrow">↓</span>
      </article>
      <article>
        <span class="flow-icon icon-lavender">02</span>
        <div>
          <small>EXECUTION BOUNDARY</small>
          <h3>Graduated sandbox policy · MCP stdio on Linux/macOS/Windows</h3>
          <p>
            Default <code>ask</code> pauses edits, shell, and MCP. Opt into
            auto-edit or sandbox-auto with explicit env gates. Shell wraps
            Bubblewrap / Seatbelt / AppContainer+Job when available. MCP stdio
            sandbox is opt-in; default stays unsandboxed with an honest warning.
          </p>
        </div>
        <span class="flow-arrow">↓</span>
      </article>
      <article>
        <span class="flow-icon icon-peach">03</span>
        <div>
          <small>LONG WORK</small>
          <h3>Compaction · repo map · prompt cache · parallel reads · jobs</h3>
          <p>
            Measured compaction events, extractive <code>/map</code>,
            provider-reported cache counters (Anthropic/OpenAI markers by
            default), concurrent list/read/search, durable{" "}
            <code>Prefer: respond-async</code> recovery after restart.
          </p>
        </div>
        <span class="flow-arrow">↓</span>
      </article>
      <article>
        <span class="flow-icon icon-lime">04</span>
        <div>
          <small>OPERATOR SURFACE</small>
          <h3>Cost honesty · OAuth refresh · plugins</h3>
          <p>
            Pinned USD schedule when every reported turn matches; otherwise
            unavailable — never guessed. MCP OAuth PKCE with refresh + one-shot
            401 auto-refresh. Local Agent Plugins READY (durable links,
            component toggles, CI fixtures); no remote marketplace claim.
          </p>
        </div>
        <span class="flow-arrow">↓</span>
      </article>
      <article>
        <span class="flow-icon icon-lavender">05</span>
        <div>
          <small>TERMINAL UI</small>
          <h3>
            SolidJS + OpenTUI · mint · Ctrl+P · reviews · / @ $ autocomplete
          </h3>
          <p>
            Veasel-branded Solid shell on OpenTUI: mint identity, pixel splash,
            Compose drafts (Shift+Enter), <kbd>Ctrl+P</kbd> command palette,
            review overlays, slash / <code>@</code> path / <code>$</code> skill
            autocomplete, MarkdownRenderable replies, DiffRenderable washes,
            context footers, builtin + custom JSON themes, and{" "}
            <code>VEASEL_TUI_REDUCED_MOTION</code>.
          </p>
        </div>
        <span class="flow-arrow">↓</span>
      </article>
      <article>
        <span class="flow-icon icon-peach">06</span>
        <div>
          <small>V-NATIVE RUNTIME</small>
          <h3>Builder · SSE · json2 — performance without fake numbers</h3>
          <p>
            The agent core is V: string builders for hot paths, SSE for
            resumable events, <code>json2</code> for contracts. We publish
            process-startup microbenchmarks when measured — never invented
            agent-quality scores or Harbor Index claims.
          </p>
        </div>
        <span class="flow-arrow">✦</span>
      </article>
    </div>
  </section>

  <section class="reality-band">
    <div class="wrap reality-inner">
      <div>
        <p class="kicker">READY NOW</p>
        <h2>
          The board
          <br />
          <span>is green where it counts.</span>
        </h2>
        <p>
          Verified prerelease <code>{release}</code>. Packages and docs track
          this tag — not a future cut that does not exist yet.
        </p>
      </div>
      <div class="status-board">
        <div class="status-head">
          <b>SHIPPED CAPABILITIES</b>
          <span>TIED TO THE REPO</span>
        </div>
        <div class="status-row">
          <span class="status-symbol done">✓</span>
          <b>Universal skills + one-shot invoke</b>
          <small>READY</small>
        </div>
        <div class="status-row">
          <span class="status-symbol done">✓</span>
          <b>Model catalog + /connect trust</b>
          <small>READY</small>
        </div>
        <div class="status-row">
          <span class="status-symbol done">✓</span>
          <b>Graduated execution policy</b>
          <small>READY</small>
        </div>
        <div class="status-row">
          <span class="status-symbol done">✓</span>
          <b>Reviewed shell + MCP calls</b>
          <small>READY</small>
        </div>
        <div class="status-row">
          <span class="status-symbol done">✓</span>
          <b>Shell + MCP stdio sandboxes (3 OS)</b>
          <small>OPT-IN</small>
        </div>
        <div class="status-row">
          <span class="status-symbol done">✓</span>
          <b>Compaction · repo map · prompt cache</b>
          <small>READY</small>
        </div>
        <div class="status-row">
          <span class="status-symbol done">✓</span>
          <b>Parallel reads · durable jobs</b>
          <small>READY</small>
        </div>
        <div class="status-row">
          <span class="status-symbol done">✓</span>
          <b>Cost schedule honesty · OAuth refresh</b>
          <small>READY</small>
        </div>
        <div class="status-row">
          <span class="status-symbol done">✓</span>
          <b>SolidJS + OpenTUI session client</b>
          <small>READY</small>
        </div>
        <div class="status-row">
          <span class="status-symbol done">✓</span>
          <b>Agent Plugins (local)</b>
          <small>READY</small>
        </div>
        <a href={`${basePath}/docs/`}>
          Open the field guide <span>↗</span>
        </a>
      </div>
    </div>
  </section>

  <section class="start wrap section-pad" id="get-started">
    <div class="start-copy">
      <p class="kicker">GET STARTED</p>
      <h2>
        Install the standard.
        <br />
        <span>Connect a model.</span>
      </h2>
      <p>
        Download the verified prerelease, run <code>/connect</code>, and work
        inside your repository with approvals you can see.
      </p>
      <div class="start-actions">
        <a class="button button-dark" href={`${basePath}/downloads/`}>
          Download Veasel Code <span>→</span>
        </a>
        <a class="text-link" href={`${basePath}/demo/`}>
          Interactive walkthrough <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link" href={`${basePath}/docs/quickstart/`}>
          Read the quickstart <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link" href={`${basePath}/docs/security/`}>
          Security model <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
    <div class="install-card">
      <div class="install-top">
        <span class="live-dot"></span> VERIFIED PREVIEW · {release}
      </div>
      <div class="install-code">
        <small>01&nbsp; DOWNLOAD FOR YOUR PLATFORM</small>
        <code>veasel</code>
        <small>02&nbsp; CONNECT A PROVIDER</small>
        <code>/connect · paste key · pick model</code>
        <small>03&nbsp; WORK WITH APPROVALS</small>
        <code>/patches · /commands · /mcp · /skills</code>
      </div>
      <div class="install-foot">
        V runtime · SolidJS + OpenTUI · local SQLite <span>♥</span>
      </div>
    </div>
  </section>

  <section class="finale">
    <div class="wrap finale-inner">
      <div class="finale-star" aria-hidden="true">
        ✳
      </div>
      <p class="kicker">OPEN SOURCE</p>
      <h2>
        Adopt the standard.
        <br />
        <span>Shape what ships next.</span>
      </h2>
      <a
        href="https://github.com/veasel-labs/veasel"
        class="button button-light"
      >
        Meet us on GitHub <span>↗</span>
      </a>
      <p class="finale-note">
        Prereleases only — verify checksums. No Harbor Index or invented
        benchmark claims on this site.
      </p>
    </div>
  </section>
</SiteLayout>
