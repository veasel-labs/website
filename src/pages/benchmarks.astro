---
import SiteLayout from "../layouts/SiteLayout.astro";
import startupReport from "../../public/data/benchmarks/cli-startup-linux-x64-2026-10-15.json";
import tuiStartupReport from "../../public/data/benchmarks/tui-startup-linux-x64-2026-10-17.json";

const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const startupResults = startupReport.operations.version;
const slowestStartup = Math.max(
  ...startupResults.map((result) => result.p50_ms),
);
const chartWidth = (value: number) =>
  Math.max(4, (Math.log(value) / Math.log(slowestStartup)) * 100);
const rssResults = startupResults.filter(
  (result) => result.rss_kb && result.rss_kb.p50_kb > 0,
);
const slowestRss = Math.max(
  1,
  ...rssResults.map((result) => result.rss_kb.p50_kb),
);
const rssChartWidth = (value: number) =>
  Math.max(4, (Math.log(value) / Math.log(slowestRss)) * 100);
const reportDate = new Date(startupReport.generated_at).toLocaleDateString(
  "en-US",
  { dateStyle: "long", timeZone: "UTC" },
);
const veaselStartup = startupResults.find(
  (result) => result.id === "veasel-code",
);
const tuiVersionP50 = tuiStartupReport.cli.version.wall.medianMs;
const tuiHelpP50 = tuiStartupReport.cli.help.wall.medianMs;
const tuiPtyP50 = tuiStartupReport.ptyConnectedMs.wall.medianMs;
const tuiVersionRssMiB = tuiStartupReport.cli.version.rssKb.medianKb / 1024;
const tuiHelpRssMiB = tuiStartupReport.cli.help.rssKb.medianKb / 1024;
const tuiReportDate = new Date(tuiStartupReport.measuredAt).toLocaleDateString(
  "en-US",
  { dateStyle: "long", timeZone: "UTC" },
);
const fmtMs = (value: number) => value.toFixed(1);
---

<SiteLayout
  title="Performance and benchmarks"
  description="Reproducible Veasel Code performance data, methodology, and independent evaluation status."
>
  <section class="doc-page bench-page">
    <p class="kicker">
      <span class="sparkle" aria-hidden="true">
        ✳
      </span>{" "}
      MEASUREMENTS / OPEN NOTEBOOK
    </p>
    <h1>
      Show the work.
      <br />
      <em>Then show the data.</em>
    </h1>
    <p class="lede">
      Every public number links to its raw report and method. This page
      separates local runtime measurements from coding-task results; a faster
      CLI launch does not mean an agent solves more tasks.
    </p>

    <section class="bench-evidence" aria-labelledby="startup-title">
      <div class="bench-section-head">
        <div>
          <p class="bench-label">LOCAL RUNTIME / COMMAND STARTUP</p>
          <h2 id="startup-title">Process launch, measured plainly.</h2>
        </div>
        <span class="bench-tag">REPRODUCIBLE BASELINE</span>
      </div>
      <p class="bench-copy">
        Median time to run each installed CLI's <code>--version</code> command.
        Bars use a log scale so the slower tools remain readable beside the
        millisecond runtimes.
      </p>

      <ol
        class="bench-chart"
        aria-label="Median command startup time. Longer bars mean slower process startup."
      >
        {startupResults.map((result) => (
          <li
            class:list={[
              "bench-result",
              result.id === "veasel-code" && "bench-result-veasel",
            ]}
          >
            <div class="bench-result-head">
              <span>{result.id}</span>
              <strong>
                {result.p50_ms}
                <small> ms</small>
              </strong>
            </div>
            <div class="bench-track" aria-hidden="true">
              <span style={`--bench-width: ${chartWidth(result.p50_ms)}%`} />
            </div>
            <p>
              p95 {result.p95_ms} ms · {result.samples} samples ·{" "}
              {result.failures} failures
            </p>
          </li>
        ))}
      </ol>

      <div class="bench-callout">
        <span aria-hidden="true">↳</span>
        <p>
          Veasel <code>{veaselStartup?.first_output_line}</code> median was{" "}
          {veaselStartup?.p50_ms} ms on this Linux x64 host. This measures
          command startup only: no model call, interactive session, repository
          task, or coding quality.
        </p>
      </div>

      <dl class="bench-meta">
        <div>
          <dt>Captured</dt>
          <dd>{reportDate} · Linux x64</dd>
        </div>
        <div>
          <dt>Method</dt>
          <dd>
            {startupReport.warmups} warmups · {startupReport.requested_samples}{" "}
            samples per CLI · interleaved order
          </dd>
        </div>
        <div>
          <dt>Model requests</dt>
          <dd>None</dd>
        </div>
        <div>
          <dt>Raw report</dt>
          <dd>
            <a
              href={`${basePath}/data/benchmarks/cli-startup-linux-x64-2026-10-15.json`}
            >
              JSON · full measurements ↗
            </a>
          </dd>
        </div>
      </dl>
    </section>

    <section class="bench-evidence" aria-labelledby="rss-title">
      <div class="bench-section-head">
        <div>
          <p class="bench-label">LOCAL RUNTIME / PEAK RSS</p>
          <h2 id="rss-title">Resident memory at launch.</h2>
        </div>
        <span class="bench-tag">SAME HOST · SAME RUN WINDOW</span>
      </div>
      <p class="bench-copy">
        Median peak RSS for each CLI's <code>--version</code> child, measured
        with Linux <code>RUSAGE_CHILDREN.ru_maxrss</code> (kilobytes). This is
        process-launch memory only — not an idle server, TUI session, or coding
        task working set.
      </p>

      <ol
        class="bench-chart"
        aria-label="Median peak RSS at --version. Longer bars mean higher resident memory."
      >
        {rssResults.map((result) => (
          <li
            class:list={[
              "bench-result",
              result.id === "veasel-code" && "bench-result-veasel",
            ]}
          >
            <div class="bench-result-head">
              <span>{result.id}</span>
              <strong>
                {(result.rss_kb.p50_kb / 1024).toFixed(1)}
                <small> MiB</small>
              </strong>
            </div>
            <div class="bench-track" aria-hidden="true">
              <span
                style={`--bench-width: ${rssChartWidth(result.rss_kb.p50_kb)}%`}
              />
            </div>
            <p>
              p50 {result.rss_kb.p50_kb} kB · p95 {result.rss_kb.p95_kb} kB ·{" "}
              {result.rss_kb.samples} samples
            </p>
          </li>
        ))}
      </ol>

      <div class="bench-callout">
        <span aria-hidden="true">↳</span>
        <p>
          Veasel peak RSS median was{" "}
          {veaselStartup?.rss_kb
            ? `${(veaselStartup.rss_kb.p50_kb / 1024).toFixed(1)} MiB`
            : "n/a"}{" "}
          ({veaselStartup?.rss_kb?.p50_kb} kB). Same disclaimer: launch only,
          not agent task quality.
        </p>
      </div>
    </section>

    <section class="bench-evidence" aria-labelledby="tui-startup-title">
      <div class="bench-section-head">
        <div>
          <p class="bench-label">LOCAL RUNTIME / TUI STARTUP + PTY</p>
          <h2 id="tui-startup-title">Terminal client, measured plainly.</h2>
        </div>
        <span class="bench-tag">LINUX X64 · ONE HOST</span>
      </div>
      <p class="bench-copy">
        Median wall time for packaged <code>veasel-tui</code>{" "}
        <code>--version</code> / <code>--help</code>, plus PTY time-to-connected
        against an isolated <code>veasel serve</code> (visible markers{" "}
        <code>connected</code>, <code>SESSIONS</code>, <code>VEASEL</code>). No
        model requests. Not interactive render FPS, not coding-task quality, not
        macOS/Windows numbers, and not Windows ConPTY coverage.
      </p>

      <ol
        class="bench-chart"
        aria-label="Median veasel-tui startup probes on Linux x64."
      >
        <li class="bench-result bench-result-veasel">
          <div class="bench-result-head">
            <span>veasel-tui --version</span>
            <strong>
              {fmtMs(tuiVersionP50)}
              <small> ms</small>
            </strong>
          </div>
          <div class="bench-track" aria-hidden="true">
            <span style="--bench-width: 100%" />
          </div>
          <p>
            p50 RSS {tuiVersionRssMiB.toFixed(1)} MiB ·{" "}
            {tuiStartupReport.cli.version.wall.count} samples ·{" "}
            {tuiStartupReport.cli.version.failures} failures
          </p>
        </li>
        <li class="bench-result bench-result-veasel">
          <div class="bench-result-head">
            <span>veasel-tui --help</span>
            <strong>
              {fmtMs(tuiHelpP50)}
              <small> ms</small>
            </strong>
          </div>
          <div class="bench-track" aria-hidden="true">
            <span
              style={`--bench-width: ${Math.max(4, (tuiHelpP50 / tuiVersionP50) * 100)}%`}
            />
          </div>
          <p>
            p50 RSS {tuiHelpRssMiB.toFixed(1)} MiB ·{" "}
            {tuiStartupReport.cli.help.wall.count} samples ·{" "}
            {tuiStartupReport.cli.help.failures} failures
          </p>
        </li>
        <li class="bench-result bench-result-veasel">
          <div class="bench-result-head">
            <span>PTY → connected home</span>
            <strong>
              {fmtMs(tuiPtyP50)}
              <small> ms</small>
            </strong>
          </div>
          <div class="bench-track" aria-hidden="true">
            <span
              style={`--bench-width: ${Math.max(4, (tuiPtyP50 / tuiVersionP50) * 100)}%`}
            />
          </div>
          <p>
            {tuiStartupReport.ptyConnectedMs.wall.count} samples ·{" "}
            {tuiStartupReport.ptyConnectedMs.failures} failures · isolated serve
          </p>
        </li>
      </ol>

      <div class="bench-callout">
        <span aria-hidden="true">↳</span>
        <p>
          Binary line <code>{tuiStartupReport.binaries.tuiVersionLine}</code>.
          Medians on this Linux x64 host only: <code>--version</code>{" "}
          {fmtMs(tuiVersionP50)} ms · <code>--help</code> {fmtMs(tuiHelpP50)} ms
          · PTY connected {fmtMs(tuiPtyP50)} ms. Windows ConPTY interactive
          smoke is still open in the product checklist — this page does not
          claim it.
        </p>
      </div>

      <dl class="bench-meta">
        <div>
          <dt>Captured</dt>
          <dd>
            {tuiReportDate} · {tuiStartupReport.host.platform}{" "}
            {tuiStartupReport.host.arch}
          </dd>
        </div>
        <div>
          <dt>Method</dt>
          <dd>{tuiStartupReport.method.cli}</dd>
        </div>
        <div>
          <dt>PTY probe</dt>
          <dd>{tuiStartupReport.method.ptyConnected}</dd>
        </div>
        <div>
          <dt>Raw report</dt>
          <dd>
            <a
              href={`${basePath}/data/benchmarks/tui-startup-linux-x64-2026-10-17.json`}
            >
              JSON · full measurements ↗
            </a>
          </dd>
        </div>
      </dl>
    </section>

    <section class="bench-status" aria-labelledby="evaluation-title">
      <div class="bench-section-head">
        <div>
          <p class="bench-label">INDEPENDENT TASK EVALUATIONS</p>
          <h2 id="evaluation-title">Status, without borrowed scores.</h2>
        </div>
      </div>
      <div class="bench-status-list">
        <article class="bench-status-row">
          <span
            class="bench-status-dot status-measured"
            aria-hidden="true"
          ></span>
          <div>
            <h3>CLI startup + peak RSS</h3>
            <p>
              Re-measured 2026-10-15 against verified{" "}
              <code>v0.41.0-next.0</code> (and peer CLIs on PATH); wall time and
              Linux <code>ru_maxrss</code> published above.
            </p>
          </div>
          <strong>Measured</strong>
        </article>
        <article class="bench-status-row">
          <span
            class="bench-status-dot status-measured"
            aria-hidden="true"
          ></span>
          <div>
            <h3>TUI startup + PTY connected</h3>
            <p>
              Linux x64 only for <code>veasel-tui</code>{" "}
              <code>0.41.0-next.0</code>: version/help wall+RSS and PTY
              time-to-connected published above. macOS/Windows baselines and
              Windows ConPTY interactive smoke remain open.
            </p>
          </div>
          <strong>Measured</strong>
        </article>
        <article class="bench-status-row">
          <span
            class="bench-status-dot status-measured"
            aria-hidden="true"
          ></span>
          <div>
            <h3>Deterministic cross-agent fixtures</h3>
            <p>
              The same externally-checked edit fixture runs against Veasel, Pi,
              Codex, mini-SWE-agent and OpenCode with scripted provider replies
              (<code>benchmarks/deterministic</code>). Latest wall times
              (2026-10-18 reports, all passing): Veasel 264 ms, Pi 1,687 ms,
              OpenCode 3,597 ms, Codex 4,423 ms, mini-SWE-agent 6,205 ms. Veasel
              additionally runs search, autonomous-shell, sequential multi-file
              edit, read-then-edit, edit-then-shell-verify, failed-shell
              recovery and failed-edit recovery fixtures plus outside-workspace
              read and write rejections (11 of 11 passing), including a check
              that the provider API key never reaches a shell command's
              environment. This measures harness and startup orchestration only;
              scripted replies say nothing about model quality, and no
              task-superiority claim is made from it.
            </p>
          </div>
          <strong>Measured</strong>
        </article>
        <article class="bench-status-row">
          <span class="bench-status-dot" aria-hidden="true"></span>
          <div>
            <h3>Harbor Index</h3>
            <p>
              A local installed-agent adapter exists (Harbor 0.24.0 contract,
              Bubblewrap + verified Linux release, ATIF validation in CI). No
              Index trial set, leaderboard score, or upstream registry
              submission — see{" "}
              <a href="https://github.com/veasel-labs/veasel/blob/main/docs/compatibility/harbor.md">
                harbor.md
              </a>
              .
            </p>
          </div>
          <strong>Not submitted</strong>
        </article>
        <article class="bench-status-row">
          <span class="bench-status-dot" aria-hidden="true"></span>
          <div>
            <h3>Terminal-Bench · SWE-bench</h3>
            <p>Independent task-resolution results have not been run.</p>
          </div>
          <strong>Not submitted</strong>
        </article>
      </div>
    </section>

    <section class="bench-method" aria-labelledby="method-title">
      <p class="bench-label">REPRODUCIBILITY</p>
      <h2 id="method-title">Same commands. Rotated order.</h2>
      <p>
        The runner records versions and 30 timed samples after three warmups,
        rotating the CLI order on each round. Each sample invokes only
        <code>--version</code> or <code>--help</code> with a local subprocess
        timeout. Missing tools and failed commands are retained as failures;
        there are no model requests or task outcomes in this experiment.
      </p>
      <a
        class="text-link"
        href="https://github.com/veasel-labs/veasel/tree/main/benchmarks"
      >
        Inspect the runner and methodology <span aria-hidden="true">↗</span>
      </a>
    </section>

    <section class="bench-method" aria-labelledby="harbor-prep-title">
      <p class="bench-label">HARBOR INDEX · PREP ONLY</p>
      <h2 id="harbor-prep-title">What exists before any submission.</h2>
      <ul class="guide-list">
        <li>
          Local adapter: <code>benchmarks/harbor/veasel_agent.py</code> (
          <code>BaseInstalledAgent</code>).
        </li>
        <li>
          Pin: Harbor <code>0.24.0</code> at commit{" "}
          <code>dc933be707feafbb9efcdf092cb8a0e391332617</code>.
        </li>
        <li>
          CI validates an ATIF trajectory with Harbor’s own validator; traces
          are not published as public artifacts (may contain workspace content).
        </li>
        <li>
          Harbor’s contribution policy requires discussing interface changes and
          human-authored PR drafts before upstream registry work.
        </li>
        <li>
          <strong>Not done:</strong> Index trial set, paid/authorized
          leaderboard runs, or a claim of built-in Harbor agent support.
        </li>
      </ul>
      <a
        class="text-link"
        href="https://github.com/veasel-labs/veasel/blob/main/docs/compatibility/harbor.md"
      >
        Read the Harbor compatibility note <span aria-hidden="true">↗</span>
      </a>
      <a class="text-link" href={`${basePath}/evals/`}>
        ATIF status & Index draft checklist <span aria-hidden="true">→</span>
      </a>
    </section>
  </section>
</SiteLayout>

<style>
  .bench-page {
    max-width: 1040px;
  }

  .bench-page > h1 em {
    color: var(--green);
  }

  .bench-evidence,
  .bench-status,
  .bench-method {
    margin-top: 26px;
  }

  .bench-evidence {
    padding: clamp(22px, 4vw, 42px);
    border: 1px solid var(--line);
    border-radius: 22px;
    background: var(--surface);
    box-shadow: 0 22px 60px #2022380b;
  }

  .bench-section-head {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 22px;
  }

  .bench-label {
    margin: 0 0 9px;
    color: var(--green-dark);
    font: 500 0.67rem var(--mono);
    letter-spacing: 0.1em;
  }

  .bench-section-head h2,
  .bench-method h2 {
    margin: 0;
    font: 600 clamp(1.55rem, 3.4vw, 2.3rem)/1.12 var(--display);
    letter-spacing: -0.035em;
  }

  .bench-tag {
    flex: 0 0 auto;
    padding: 9px 12px;
    border-radius: 99px;
    background: var(--mint);
    color: var(--green-dark);
    font: 500 0.59rem var(--mono);
    letter-spacing: 0.04em;
  }

  .bench-copy,
  .bench-method > p:not(.bench-label) {
    max-width: 720px;
    color: var(--muted);
    line-height: 1.75;
  }

  .bench-copy code,
  .bench-method code {
    padding: 2px 5px;
    border-radius: 5px;
    background: var(--surface-soft);
    font: 0.86em var(--mono);
  }

  .bench-chart {
    display: grid;
    gap: 17px;
    padding: 22px 0 4px;
    margin: 0;
    list-style: none;
  }

  .bench-result {
    --bar-color: #85869b;
  }

  .bench-result-veasel {
    --bar-color: var(--green);
  }

  .bench-result-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    font: 0.75rem var(--mono);
  }

  .bench-result-head span {
    overflow-wrap: anywhere;
    color: var(--ink);
  }

  .bench-result-head strong {
    white-space: nowrap;
    font-size: 0.9rem;
    font-weight: 500;
  }

  .bench-result-head small {
    color: var(--muted);
    font-size: 0.68rem;
  }

  .bench-track {
    height: 9px;
    overflow: hidden;
    margin-top: 7px;
    border-radius: 99px;
    background: var(--surface-soft);
  }

  .bench-track span {
    display: block;
    width: var(--bench-width);
    height: 100%;
    border-radius: inherit;
    background: var(--bar-color);
  }

  .bench-result > p {
    margin: 5px 0 0;
    color: var(--muted);
    font: 0.62rem var(--mono);
  }

  .bench-callout {
    display: flex;
    gap: 12px;
    align-items: start;
    padding: 15px 17px;
    margin-top: 23px;
    border-left: 3px solid var(--green);
    border-radius: 0 10px 10px 0;
    background: var(--surface-soft);
  }

  .bench-callout > span {
    color: var(--green-dark);
    font: 1.2rem var(--mono);
  }

  .bench-callout p {
    margin: 0;
    color: var(--muted);
    font-size: 0.83rem;
    line-height: 1.65;
  }

  .bench-meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px 25px;
    padding-top: 20px;
    margin: 20px 0 0;
    border-top: 1px solid var(--line);
  }

  .bench-meta div {
    min-width: 0;
  }

  .bench-meta dt {
    color: var(--muted);
    font: 0.6rem var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .bench-meta dd {
    margin: 5px 0 0;
    font-size: 0.8rem;
    overflow-wrap: anywhere;
  }

  .bench-meta a {
    color: var(--green-dark);
    text-underline-offset: 3px;
  }

  .bench-status-list {
    margin-top: 16px;
    border-top: 1px solid var(--line);
  }

  .bench-status-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 14px;
    padding: 17px 3px;
    border-bottom: 1px solid var(--line);
  }

  .bench-status-dot {
    width: 9px;
    height: 9px;
    border: 2px solid #aaaabd;
    border-radius: 50%;
  }

  .status-measured {
    border-color: var(--green);
    background: var(--green);
    box-shadow: 0 0 0 4px var(--mint);
  }

  .bench-status-row h3 {
    margin: 0;
    font: 600 1rem var(--display);
  }

  .bench-status-row p {
    margin: 4px 0 0;
    color: var(--muted);
    font-size: 0.77rem;
  }

  .bench-status-row > strong {
    color: var(--muted);
    font: 0.59rem var(--mono);
    text-align: right;
    text-transform: uppercase;
  }

  .bench-method {
    padding: 28px 0 4px;
    border-top: 1px solid var(--line);
  }

  .bench-method .text-link {
    display: inline-flex;
    margin-top: 5px;
  }

  :global(:root[data-theme="dark"]) .bench-evidence {
    box-shadow: 0 22px 60px #0003;
  }

  :global(:root[data-theme="dark"]) .bench-tag,
  :global(:root[data-theme="dark"]) .status-measured {
    background: #214333;
    color: #a8e6bc;
  }

  :global(:root[data-theme="dark"]) .bench-meta a {
    color: #a8e6bc;
  }

  @media (max-width: 680px) {
    .bench-section-head {
      flex-direction: column;
      gap: 14px;
    }

    .bench-meta {
      grid-template-columns: 1fr;
    }

    .bench-status-row {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .bench-status-row > strong {
      grid-column: 2;
      text-align: left;
    }
  }
</style>
